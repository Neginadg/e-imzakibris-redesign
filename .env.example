# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
MAIL_FROM=no-reply@your-domain.com
COMPANY_EMAIL=info@your-domain.com

# Optional PDF attachment sent with application customer confirmation email
# Use a path relative to the project root, or an absolute path on the server
CUSTOMER_ATTACHMENT_PATH=assets/docs/applicationguidelines/dbh_nesue_10_last_clean.pdf

# Signature verification (support/verify.html -> /api/verify-signature)
# REST validation endpoint of a DSS (Digital Signature Service) instance.
# Defaults to the EU public demo if unset (not for production use).
# See deploy/dss/ for a self-hosted setup.
DSS_VALIDATION_URL=https://your-dss-host/services/rest/validation/validateSignature
