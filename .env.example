# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
MAIL_FROM=no-reply@your-domain.com
COMPANY_EMAIL=info@your-domain.com

# Optional PDF attachment sent with application customer confirmation email
# Use a path relative to the project root, or an absolute path on the server
CUSTOMER_ATTACHMENT_PATH=assets/docs/applicationguidelines/dbh_nesue_10_last_clean.pdf

# PayPoint (credit card payments)
PAYPOINT_MERCHANT_CODE=YOUR_PAYPOINT_MERCHANT_CODE
PAYPOINT_MERCHANT_USER=YOUR_PAYPOINT_MERCHANT_USER
PAYPOINT_SECRET_KEY=YOUR_PAYPOINT_SECRET_KEY
# 'test' (default, safe) or 'production' — only switch once verified end-to-end
PAYPOINT_ENV=test
# Optional — only needed if PayPoint's documented hosts ever need overriding
# without a code change. Production is https://paypointcyprus.com (API) and
# https://paypointcyprus.com/ecom (gateway).
PAYPOINT_API_BASE_URL=
PAYPOINT_ECOM_BASE_URL=
